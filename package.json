{
  "name": "zip-image-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "codegen": "node node_modules/react-native/scripts/generate-codegen-artifacts.js --path . --targetPlatform all --outputPath work/codegen"
  },
  "codegenConfig": {
    "name": "ZipImageViewerSpec",
    "type": "all",
    "jsSrcsDir": "mobile/specs",
    "android": {
      "javaPackageName": "com.brite.zipimageviewer.bridge"
    },
    "ios": {
      "componentProvider": {"ZIVArchiveCover": "ArchiveCoverComponentView"},
      "modulesProvider": {
        "ZipImageViewer": "ZipImageViewerModule"
      }
    }
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  }
}
